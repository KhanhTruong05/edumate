# Docker Compose đọc file .env tại thư mục gốc edumate nếu có.
# Không cần tạo .env để chạy demo. Chỉ thêm hai biến Gemini khi muốn gọi AI thật.
EDUMATE_PORT=8080
BACKEND_PORT=8000
AI_PORT=8001
GEMINI_API_KEY=
GEMINI_MODEL=
# Tokens nội bộ mẫu chỉ dùng cho demo localhost; dùng ký tự chữ/số/dấu gạch.
DEMO_PROXY_TOKEN=edumate-local-demo-proxy
