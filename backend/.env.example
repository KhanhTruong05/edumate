# Demo chỉ chạy trên máy cá nhân. Không triển khai công khai chế độ này.
APP_MODE=demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chọn ID model đang được tài khoản của bạn cấp quyền; không đặt key ở frontend.
GEMINI_API_KEY=
GEMINI_MODEL=
# Để trống để dùng Gemini trong cùng tiến trình khi chạy dev.
# Docker Compose tự đặt URL/token và chuyển key Gemini sang container ai.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
# Chỉ dùng khi đặt backend sau proxy demo nội bộ; dev loopback không cần.
DEMO_PROXY_TOKEN=
# Adapter Firebase có sẵn; chưa ghép vào repository của các route demo.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Dùng Application Default Credentials khi nối cloud; không commit tệp khóa.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json
