# Demo chỉ chạy trên máy cá nhân. Không triển khai công khai chế độ này.
APP_MODE=demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chọn ID model đang được tài khoản của bạn cấp quyền; không đặt key ở frontend.
GEMINI_API_KEY=
GEMINI_MODEL=
# Adapter Firebase có sẵn; chưa ghép vào repository của các route demo.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Dùng Application Default Credentials khi nối cloud; không commit tệp khóa.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json
