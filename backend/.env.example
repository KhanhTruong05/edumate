# Demo chỉ chạy trên máy cá nhân. Không triển khai công khai chế độ này.
APP_MODE=demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AI chạy service riêng ở cổng 8001; Gemini key/model cấu hình ở service AI.
AI_SERVICE_URL=http://127.0.0.1:8001
# Chỉ bật khi Docker publish backend trên localhost (Compose tự đặt).
DEMO_ALLOW_DIRECT_ACCESS=false
# Chỉ dùng khi đặt backend sau proxy demo nội bộ; dev loopback không cần.
DEMO_PROXY_TOKEN=
# Adapter Firebase có sẵn; chưa ghép vào repository của các route demo.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Dùng Application Default Credentials khi nối cloud; không commit tệp khóa.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json
